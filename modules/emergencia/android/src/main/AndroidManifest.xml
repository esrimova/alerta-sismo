<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Baliza BLE. ADVERTISE y CONNECT son de Android 12+; los dos primeros
       cubren versiones anteriores. neverForLocation evita que Android exija
       permiso de ubicacion precisa por usar Bluetooth. -->
  <uses-permission android:name="android.permission.BLUETOOTH"
                   android:maxSdkVersion="30" />
  <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
                   android:maxSdkVersion="30" />
  <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"
                   android:usesPermissionFlags="neverForLocation" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

  <!-- Permiso que exige el fork de bitchat para dejarse encender. Es de nivel
       de firma, asi que solo funciona porque las dos apps van firmadas con la
       misma clave. -->
  <uses-permission android:name="com.bitchat.droid.permission.EMERGENCIA" />

  <!-- Android 11+ oculta las apps instaladas salvo que se declaren. Sin esto,
       la comprobacion de si bitchat esta instalado diria siempre que no. -->
  <queries>
    <package android:name="com.bitchat.droid" />
    <!-- Android 11+ oculta los servicios instalados salvo que se declaren. Sin
         esto, el sintetizador de voz no se encuentra y la baliza queda muda. -->
    <intent>
      <action android:name="android.intent.action.TTS_SERVICE" />
    </intent>
  </queries>

</manifest>
